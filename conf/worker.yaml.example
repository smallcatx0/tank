# 消费者进程配置（无 HTTP/gRPC，仅装配存储与任务消费）
name: sth_worker
desc: 分布式任务消费者
env: dev
debug: true

startup_timeout: 15s # 存储初始化总期限
shutdown_timeout: 30 # 秒，优雅退出总期限

# 日志配置
log:
  type: file # 可选 file stdout
  level: DEBUG
  path: "./logs/worker.log" # 仅 file 模式使用；按天切割，固定保留 365 天

# 主数据库
mysql:
  debug: true
  dsn: 'root:123123@tcp(mysql-serv:3306)/bs?charset=utf8mb4&parseTime=True&loc=Local'
  maxIdleConns: 10 # <=0 使用 10
  maxOpenConns: 100 # <=0 使用 100
  connMaxLifetime: 300 # 秒；<=0 使用 300
  prefix: '' # 表名前缀，global.MysqlPrefix() 读取

# 主 redis
redis:
  addr: redis-serv:6379
  db: 0
  pwd: ''
  pool_size: 30 # <=0 使用 30
  max_reties: 3 # 沿用代码键名；重试次数
  prefix: '' # 缓存 key 前缀，global.CachePrefix() 读取

# 心跳日志配置
metrics:
  enable: false # 系统状态日志心跳
  dt: 10 # 秒，默认 10；启用后无效或溢出的间隔会跳过心跳

# Prometheus 与追踪独立开关；metrics.enable（上文）仍仅为日志心跳。
# 启用后核对 shutdown_timeout；预算不足将警告并跳过观测。worker 全开建议 55 秒。
observability:
  service_name: sth_worker
  metrics:
    enable: false
    address: 127.0.0.1:9092 # 容器内供抓取时改为 0.0.0.0，限制可信网络访问
    shutdown_timeout: 2s
  tracing:
    enable: false
    endpoint: http://127.0.0.1:4318/v1/traces
    sample_ratio: 0.1 # 联调设为 1；比例只控制根链路，父采样决定优先
    export_timeout: 3s
    shutdown_timeout: 5s
